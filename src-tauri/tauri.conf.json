{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noto Logistics Robot Simulator",
  "version": "0.1.0",
  "identifier": "dev.noto-sim.logistics",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noto Logistics Robot Simulator",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
